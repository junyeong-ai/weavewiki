{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claudegen://schemas/module_map.json",
  "title": "Claudegen Module Map",
  "type": "object",
  "required": ["module_map_version", "modules"],
  "properties": {
    "module_map_version": {
      "type": "string",
      "description": "Semver for module map compatibility."
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "paths", "coverage_ratio", "key_files", "dependencies"],
        "properties": {
          "module_id": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}},
          "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "estimated_value_score": {"type": "number", "minimum": 0, "maximum": 1},
          "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
          "key_files": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
